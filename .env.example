# Environment Variables — PredLife
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or .env to Git

# =============================================
# RAZORPAY PAYMENT GATEWAY
# =============================================
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET

# Webhook secret from Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Public key (safe to expose to browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY

# =============================================
# DATABASE
# =============================================
DATABASE_URL="file:./prisma/dev.db"

# =============================================
# ADMIN DASHBOARD
# =============================================
# Set a long random secret for admin access
ADMIN_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# =============================================
# DATA RETENTION
# =============================================
# Number of days before old anonymous session data is purged
DATA_RETENTION_DAYS=90

# =============================================
# OPTIONAL EMAIL DELIVERY
# =============================================
# If you integrate email sending (e.g. Resend, SendGrid)
# EMAIL_API_KEY=REPLACE_WITH_YOUR_EMAIL_KEY
# EMAIL_FROM=noreply@predlife.in
